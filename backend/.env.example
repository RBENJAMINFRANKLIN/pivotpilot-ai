# Copy to backend/.env and adjust. Every value has a safe local default; nothing here is required
# for the local demo. Never commit a real .env file.

ENVIRONMENT=development
APP_SECRET=change-me-to-a-long-random-string   # signs local login tokens
DATABASE_URL=sqlite:///./pivotpilot.db         # or postgresql://user:pass@localhost/pivotpilot
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false                            # true when served over HTTPS

# --- Sign-in -------------------------------------------------------------
AUTH_MODE=local                                # local | supabase (Supabase = future/hosted)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# --- Guest limits ----------------------------------------------------------
GUEST_RETENTION_DAYS=14
GUEST_MAX_TRANSITIONS=3
GUEST_MAX_RESUME_VERSIONS=5
GUEST_DAILY_AI_CALLS=40

# --- File storage ----------------------------------------------------------
STORAGE_BACKEND=local                          # local | supabase
STORAGE_LOCAL_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880

# --- AI providers (optional) -----------------------------------------------
# rules = no AI, fully deterministic (default). anthropic = Claude. openai_compatible = local
# servers such as Ollama / LM Studio / vLLM.
AI_PROVIDER=rules
# Per-task override, e.g. AI_PROVIDER_OVERRIDES=question_generation=anthropic,resume_extraction=openai_compatible
AI_PROVIDER_OVERRIDES=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=llama3.1
AI_SEND_RESUME_TO_HOSTED=true                  # false keeps resume text away from hosted AI

# --- Live resource discovery (placeholders, see docs/FUTURE.md) ----------------
YOUTUBE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# --- Rate limits (per IP and per workspace) ------------------------------------
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=6
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_GUEST_CREATE_PER_HOUR=20

DEMO_MODE_ENABLED=true
